# ==============================================================================
# Kashyap Classes — Environment Variables Template
# ==============================================================================
# Copy this file to `.env` for local development or configure in deployment
# secrets. Never commit real secret keys to version control.

# ------------------------------------------------------------------------------
# 1. AI Studio Runtime & Gemini / Google Maps Platform
# ------------------------------------------------------------------------------
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"
VITE_GOOGLE_MAPS_API_KEY="MY_GOOGLE_MAPS_API_KEY"
GOOGLE_MAPS_API_KEY="MY_GOOGLE_MAPS_API_KEY"

# ------------------------------------------------------------------------------
# 2. Firebase Client SDK (Optional overrides; defaults load firebase-applet-config.json)
# ------------------------------------------------------------------------------
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""
VITE_FIREBASE_FIRESTORE_DATABASE_ID=""

# ------------------------------------------------------------------------------
# 3. Firebase Admin SDK & Admin Access Control (Server-Side Secrets)
# ------------------------------------------------------------------------------
# Comma-separated admin emails and/or UIDs permitted to access /admin & upload routes
VITE_ADMIN_EMAILS="rishishrivastav16@gmail.com"
ADMIN_EMAILS="rishishrivastav16@gmail.com"
ADMIN_UIDS=""

# Optional: Single-line Firebase Service Account JSON string for non-ADC hosts
# (e.g. Vercel / Render / custom Node servers). Keep server-side ONLY (never VITE_*).
FIREBASE_SERVICE_ACCOUNT_JSON=""

# ------------------------------------------------------------------------------
# 4. Cloudflare R2 Private PDF Storage (Server-Side Secrets)
# ------------------------------------------------------------------------------
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""

# ------------------------------------------------------------------------------
# 5. Razorpay Payment Gateway (INR Checkout & HMAC Verification)
# ------------------------------------------------------------------------------
# Key ID can be public or returned cleanly by /api/create-order; NEVER expose Secret!
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
